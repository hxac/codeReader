\n\t\t\t\t\t\t\t\tbegin\n\t\t\t\t\t\t\t\t\tmin <= row2[index - 1];\n\t\t\t\t\t\t\t\t\tcoordinate[index] <= index - 1;\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tif(col < OVERLAPWIDTH && min < row2[index + 1])\n\t\t\t\t\t\t\t\tbegin\n\t\t\t\t\t\t\t\t\tmin <= row2[index + 1];\n\t\t\t\t\t\t\t\t\tcoordinate[index] <= index + 1;\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tcost[col] = cost[col] + min;\n\t\t\t\t\t\tend\n\t\t\t\tend\n\t\tendcase\n\tend\n\t\t\t\t\n\t\n//�������е���������ʱ�����Կ�ʼѰ����ѷ������\n\t\n\n\nendmodule","numLines":272,"startLine":1,"totalLines":272}},"sourceToolAssistantUUID":"a945b15d-a933-44ef-94f8-4340234ac88b","userType":"external","entrypoint":"sdk-cli","cwd":"/home/runner/work/codeReader/codeReader/work/mhhai-ImageStitchBasedOnFPGA","sessionId":"c623dcfd-908f-4058-ac1a-4cbaf22c53d9","version":"2.1.226","gitBranch":"master"}
