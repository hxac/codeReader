# 提示词文件强制 LF，避免 Windows autocrlf 在 checkout 时转 CRLF 导致
# codereader.prompts.signature() 跨平台不一致（配合 signature() 内的 normalize 双保险）。
prompts/*.md text eol=lf
*.task.md   text eol=lf
*.prompt.md text eol=lf
# Python 源码也强制 LF（一致性，防 Windows 编辑器 CRLF）
src/codereader/*.py text eol=lf
tests/*.py text eol=lf
